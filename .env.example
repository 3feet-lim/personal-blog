# --- Frontend (web) ---
NEXT_PUBLIC_APP_NAME=personal-blog
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Backend (api) ---
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

DATABASE_URL=postgresql+psycopg2://personal_blog:personal_blog@db:5432/personal_blog

DEFAULT_AUTH_PROVIDER=google
# Demo auth accepts the X-Demo-User header without verification.
# Keep this true only for local development, never enable it in production.
ENABLE_DEMO_AUTH=true

SESSION_SECRET=change-this-session-secret
SESSION_COOKIE_NAME=personal_blog_session
SESSION_HTTPS_ONLY=false

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/callback/google

# --- Object storage (local: MinIO / prod: AWS S3) ---
# Set S3_ENDPOINT_URL for local MinIO. Leave empty in production to target real AWS S3.
S3_ENDPOINT_URL=http://minio:9000
S3_BUCKET=personal-blog
S3_REGION=us-east-1
# In production, leave these empty and rely on the ECS Task Role (IAM) instead.
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin

# --- MinIO container root credentials (local only) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Database (db) ---
POSTGRES_DB=personal_blog
POSTGRES_USER=personal_blog
POSTGRES_PASSWORD=personal_blog
